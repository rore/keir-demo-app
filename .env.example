# Optional server-process fallback for AI authoring. The app does not load this
# file. Prefer the local Configure dialog. A saved ai-authoring.json takes
# precedence; environment settings apply only when that file is absent.
# Set a positive total allowance to cap Daymark spending. Omit it for no Daymark cap.

# OpenAI
# KEIR_AI_PROVIDER=openai
# KEIR_AI_MODEL=gpt-5.6-terra
# KEIR_AI_MAX_USD=1.00
# OPENAI_API_KEY=

# Anthropic
# KEIR_AI_PROVIDER=anthropic
# KEIR_AI_MODEL=claude-haiku-5-5
# KEIR_AI_MAX_USD=1.00
# ANTHROPIC_API_KEY=
